[Unit]
Description=Cash register kiosk (cage + chromium)
After=cashregister.service systemd-user-sessions.service
Wants=cashregister.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=tienda
Group=tienda
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
# Keyboard layout for the kiosk session. REQUIRED -- do not assume the system
# setting covers this. cage/wlroots use xkbcommon, which reads these env vars
# and does NOT read /etc/default/keyboard (that file is for the console and
# Xorg). With these unset, xkbcommon silently falls back to "us", so the n-tilde
# key types ";" and dead-key accents are dropped -- corrupting product names as
# they are typed. Cost us three mangled products before it was spotted.
Environment=XKB_DEFAULT_LAYOUT=latam
Environment=XKB_DEFAULT_MODEL=pc105
# --kiosk: no chrome, no address bar. The other flags remove the ways a cashier
# could otherwise reach a file picker, a download, or a second window.
ExecStart=/usr/bin/cage -- /usr/bin/chromium \
    --kiosk \
    --no-first-run \
    --disable-translate \
    --disable-features=TranslateUI \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --disable-session-crashed-bubble \
    --noerrdialogs \
    --check-for-update-interval=31536000 \
    http://127.0.0.1:8080/
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
